NODE_ENV=development
PORT=4300
APP_URL=http://127.0.0.1:4173
ADMIN_URL=http://127.0.0.1:4174
API_URL=http://127.0.0.1:4300
DATABASE_PATH=./data/kawang.db
MAINTENANCE_PATH=./data/maintenance.json
WORKER_POLL_MS=5000
JWT_SECRET=replace-with-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
DEFAULT_REQUEST_TIMEOUT_MS=15000

# 内部接口共享密钥，用于 Worker 与 API Server 之间的通信鉴权
INTERNAL_SECRET=your-internal-secret-key-here

# Worker 内部 HTTP 服务端口，API Server 通过此端口向 Worker 发送轮询触发请求
WORKER_INTERNAL_PORT=4301
