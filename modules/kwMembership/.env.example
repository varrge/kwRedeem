# kwRedeem 项目根目录。Go worker 会读取该目录的 .env，并直接打开其中的 DATABASE_PATH。
KAWANG_PROJECT_ROOT=../..

# 命令行检查可显式读取生产环境文件；systemd 会直接加载同一文件。
# KWMEMBERSHIP_ENV_FILE=/etc/kwmembership.env

# 默认由 Python 串行付款执行器接管浏览器；legacy-go 仅用于旧实现诊断。
KWMEMBERSHIP_CHECKOUT_EXECUTOR=python

# 留空时会自动查找 google-chrome/chromium；Linux 非标准安装路径时填写绝对路径。
# KWMEMBERSHIP_CHROME_PATH=/usr/bin/google-chrome

# 只让结账浏览器走本机代理。生产服务器使用新加坡出口时填写本机 Mihomo 监听地址。
# KWMEMBERSHIP_CHROME_PROXY_SERVER=http://127.0.0.1:7890
# 远端代理需要认证时，将账号和密码分开写入服务器环境文件，不要拼进 URL。
# KWMEMBERSHIP_CHROME_PROXY_USERNAME=proxy-user
# KWMEMBERSHIP_CHROME_PROXY_PASSWORD=proxy-password

# 只让 EfunCard Open API 走本机代理，避免改变会员状态、SpaceX Card 等其他上游请求的出口。
# KWMEMBERSHIP_EFUNCARD_PROXY_URL=http://127.0.0.1:7890

# Linux 生产服务器使用私有 Xvfb 虚拟屏幕时设为 true；仍由 Python 串行执行、Go 签发 Permit。
# KWMEMBERSHIP_VISIBLE_BROWSER=true

# 单次自动结账浏览器会话总超时，默认 90000 毫秒。
# KWMEMBERSHIP_BROWSER_TIMEOUT_MS=90000

# Python 付款执行器只允许通过本机回环接口连接。生产环境必须生成独立随机密钥。
KWMEMBERSHIP_EXECUTOR_LISTEN=127.0.0.1:4312
KWMEMBERSHIP_EXECUTOR_SECRET=replace-with-at-least-32-random-characters

# fixture 使用假页面；preflight 打开真实付款页但拒绝付款命令；live 才允许受控真实付款。
KWMEMBERSHIP_PYTHON_EXECUTOR_MODE=fixture
KWMEMBERSHIP_LIVE_PAYMENT_ENABLED=false
