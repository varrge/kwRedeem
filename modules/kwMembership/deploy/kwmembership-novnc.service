[Unit]
Description=kwMembership localhost-only noVNC gateway
Requires=kwmembership-x11vnc.service
After=kwmembership-x11vnc.service

[Service]
Type=simple
ExecStart=/usr/bin/websockify --web=/usr/share/novnc 127.0.0.1:6080 127.0.0.1:5900
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
