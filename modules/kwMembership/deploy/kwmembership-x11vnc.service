[Unit]
Description=kwMembership localhost-only VNC bridge
Requires=kwmembership-xvfb.service
After=kwmembership-xvfb.service

[Service]
Type=simple
ExecStart=/usr/bin/x11vnc -display :99 -localhost -forever -shared -nopw -rfbport 5900 -xkb
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
