[Unit]
Description=kwMembership serial Python payment executor
Requires=kwmembership-worker.service
After=kwmembership-worker.service

[Service]
Type=simple
User=@@RUN_USER@@
Group=@@RUN_GROUP@@
WorkingDirectory=@@INSTALL_DIR@@
EnvironmentFile=@@ENV_FILE@@
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PLAYWRIGHT_BROWSERS_PATH=@@INSTALL_DIR@@/.playwright-browsers
ExecStart=@@PYTHON_BIN@@ -m python_executor
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
